# Kompyuterda (PyCharm) ishlab chiqish uchun. Nusxa:  copy .env.dev.example .env
# Bu sozlama bilan Docker shart emas: baza — db.sqlite3, real vaqt — xotirada.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-faqat-kompyuter-uchun-serverda-ishlatmang
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATA_DIR=data

# PostgreSQL + Redis bilan sinamoqchi bo'lsangiz (docker compose -f docker-compose.dev.yml up -d):
# DATABASE_URL=postgres://terry:terry@localhost:5432/terry
# REDIS_URL=redis://localhost:6379/0
