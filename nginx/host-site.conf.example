# Serverda nginx allaqachon bo'lsa (boshqa saytlar bilan) — Terry Jar uchun subdomen.
# 1) Nusxa:  sudo cp nginx/host-site.conf.example /etc/nginx/sites-available/terry
# 2) SUBDOMEN ni almashtiring (masalan terry.example.uz), WEB_PORT boshqacha bo'lsa 8010 ni ham
# 3) sudo ln -s /etc/nginx/sites-available/terry /etc/nginx/sites-enabled/ && sudo nginx -t && sudo systemctl reload nginx
# 4) SSL: sudo certbot --nginx -d SUBDOMEN      (certbot 443 blokini o'zi qo'shadi va yangilab turadi)

limit_req_zone $binary_remote_addr zone=terry_login:10m rate=10r/m;

map $http_upgrade $terry_conn_upgrade { default upgrade; '' close; }

server {
    listen 80;
    server_name SUBDOMEN;

    client_max_body_size 50m;
    server_tokens off;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location /ws/ {
        proxy_pass http://127.0.0.1:8010;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $terry_conn_upgrade;
        proxy_read_timeout 3600s;
    }

    location = /accounts/login/ {
        limit_req zone=terry_login burst=10 nodelay;
        proxy_pass http://127.0.0.1:8010;
    }

    location / {
        proxy_pass http://127.0.0.1:8010;
        proxy_read_timeout 120s;
    }
}
