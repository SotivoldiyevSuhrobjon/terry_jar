# ===== Terry Jar — server sozlamalari =====
# Nusxa oling:  cp .env.example .env   va qiymatlarni to'ldiring. .env Git'ga TUSHMAYDI.

# Qaysi rejim:
#   COMPOSE_PROFILES=proxy  — server faqat shu loyiha uchun: o'z nginx + SSL (80/443 portlar)
#   COMPOSE_PROFILES=       — serverda nginx allaqachon bor (boshqa saytlar): ilova 127.0.0.1:WEB_PORT da,
#                             subdomen host nginx orqali ulanadi (DEPLOY.md, «Mavjud serverda subdomen»)
COMPOSE_PROFILES=proxy
WEB_PORT=8010

# Domen yoki subdomen (DNS A yozuvi server IP siga qaratilgan bo'lsin)
DOMAIN=terry.example.uz
CERTBOT_EMAIL=siz@example.com

# Django
DJANGO_SECRET_KEY=            # yaratish: python3 -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_ALLOWED_HOSTS=terry.example.uz
DJANGO_CSRF_TRUSTED_ORIGINS=https://terry.example.uz
DJANGO_ADMIN_URL=boshqaruv-ozgartiring/   # admin panel manzili — taxmin qilib bo'lmaydigan qiling
DJANGO_DEBUG=0

# PostgreSQL
POSTGRES_DB=terry
POSTGRES_USER=terry
POSTGRES_PASSWORD=            # uzun tasodifiy parol

# Bosh administrator (init_users yaratadi). Parol bo'sh qolsa — avtomatik yaratilib ekranga chiqadi
ADMIN_USERNAME=admin
ADMIN_FULL_NAME=Suhrobjon
ADMIN_PASSWORD=

# Ixtiyoriy
WEB_WORKERS=3                 # 4 vCPU uchun 3 yetarli
SESSION_HOURS=16              # bir smena + zaxira; keyin qayta kirish so'raladi
BACKUP_KEEP_DAYS=14
LOG_LEVEL=INFO
